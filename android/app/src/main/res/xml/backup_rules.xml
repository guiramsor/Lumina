<?xml version="1.0" encoding="utf-8"?>
<!--
  Lo mismo que data_extraction_rules.xml, para Android 11 y anteriores.
  Las credenciales de Supabase no entran en la copia de seguridad, y la caché
  de escaneo tampoco porque apunta a archivos que no se restauran.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="lumina_sync.xml" />
    <exclude domain="sharedpref" path="lumina_escaneo.xml" />
</full-backup-content>
