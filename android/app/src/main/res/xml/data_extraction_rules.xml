<?xml version="1.0" encoding="utf-8"?>
<!--
  Qué entra en la copia de seguridad de Android (API 31+).

  Por omisión entra TODO, y eso incluía `lumina_sync.xml`, que guarda el
  access_token y el refresh_token de Supabase. Dos motivos para sacarlos:

  1. Son credenciales. No tienen por qué viajar a la copia de seguridad de
     Google ni acabar en otro teléfono al restaurar.
  2. Al restaurar no sirven: el token que trae la copia ya ha caducado, y la
     app se quedaba «con sesión» pero incapaz de sincronizar. Vale más pedir la
     contraseña una vez que fingir una sesión que no funciona.

  `lumina_escaneo.xml` es una caché de escaneo: guarda rutas a `cacheDir`, que
  no se restaura, así que recuperarla solo trae rutas muertas.

  El progreso, los marcadores, las estadísticas y los ajustes sí se guardan:
  es lo único que duele perder al cambiar de teléfono.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="lumina_sync.xml" />
        <exclude domain="sharedpref" path="lumina_escaneo.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="lumina_sync.xml" />
        <exclude domain="sharedpref" path="lumina_escaneo.xml" />
    </device-transfer>
</data-extraction-rules>
